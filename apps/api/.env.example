# Local development only; no credentials or external services.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
APP_ORIGIN=http://127.0.0.1:3000
# Leave blank here. setup:env generates a private random key in ignored .env.
CSRF_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Gmail address and a NEW App Password. Never commit a real password.
APPLICATION_EMAIL=
APPLICATION_PASSWORD=
MONGODB_URI=mongodb://127.0.0.1:27017/sallty?replicaSet=rs0&directConnection=true
# Local product images. Never commit this directory or expose it as static files.
LOCAL_UPLOAD_ROOT=../../.local/uploads
