{
  "name": "@sallty/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.json && node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint src test scripts",
    "test": "node --env-file-if-exists=.env --import tsx --test test/*.test.ts",
    "test:integration": "node --test test/auth.integration.test.mjs test/catalog.integration.test.mjs test/orders.integration.test.mjs",
    "mail:check": "node --env-file-if-exists=.env scripts/check-mail.mjs",
    "db:start": "node scripts/start-mongo.mjs",
    "db:init": "node --env-file-if-exists=.env --import tsx scripts/init-replica.ts",
    "db:check": "node --env-file-if-exists=.env --import tsx scripts/check-transaction.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.1.2",
    "@sallty/contracts": "workspace:*",
    "argon2": "0.45.1",
    "mongoose": "9.11.1",
    "multer": "2.4.0",
    "nodemailer": "10.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@sallty/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/nodemailer": "8.0.2",
    "smtp-server": "3.19.18",
    "tsx": "4.23.15"
  }
}
